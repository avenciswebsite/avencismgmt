# ==============================================================================
# AVENCIS WORKFORCE MANAGEMENT (WFM) — ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local and populate with your credentials:
# cp .env.example .env

# Application Metadata
VITE_APP_NAME="Avencis Workforce Management"
VITE_APP_ENV="development"
VITE_APP_VERSION="1.0.0"

# ------------------------------------------------------------------------------
# SUPABASE BACKEND CONFIGURATION (PLACEHOLDERS ONLY)
# ------------------------------------------------------------------------------
# Replace these with your actual Supabase project credentials in your private .env:
# https://supabase.com/dashboard/project/<your-project-id>/settings/api
VITE_SUPABASE_URL=https://mlopgvkvzhwhkbewhefb.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_CZCMyb2JJdj57VZ6SkG4yQ_-nGo2mIN

# ------------------------------------------------------------------------------
# APPLICATION FEATURE FLAGS & DEV SETTINGS
# ------------------------------------------------------------------------------
# Data Source Mode: 'supabase' for live backend
VITE_DATA_SOURCE_MODE=supabase
# When true, allows fallback to the in-memory store during development & testing
VITE_ENABLE_MOCK_FALLBACK=false

# Geolocation Defaults (Latitude, Longitude)
VITE_DEFAULT_LATITUDE=19.0760
VITE_DEFAULT_LONGITUDE=72.8777

# ------------------------------------------------------------------------------
# SERVER-SIDE ONLY CONFIGURATION (NEVER PREFIX WITH VITE_)
# ------------------------------------------------------------------------------
# Use for Supabase CLI, administrative scripts, or serverless Edge Functions
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
